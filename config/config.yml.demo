# UI 自动化测试配置文件 - 示例模板
# 请复制此文件为 config.yml，并填写实际配置值

# 浏览器配置
browser:
  name: chromium  # chromium, firefox, webkit
  headless: true  # 无头模式（不显示浏览器窗口）
  slow_mo: 0  # 操作延迟 (毫秒)
  timeout: 30000  # 默认超时 (毫秒)
  viewport:
    width: 1920
    height: 1080
  args:
    - --start-maximized
    - --disable-notifications

# 测试配置
test:
  timeout: 30000
  retry: 2

# 多环境配置
environments:
  # 当前激活的环境: "env1" 或 "env2"
  active: "env1"
  
  # 环境1
  "env1":
    base_url: http://your_server_ip:port/dataapp  # ⚠️ 替换为实际服务器地址
    pages:
      my_data: /#/jssjzx/grsjzx/myarchive
      data_query: /#/jssjzx/grsjzx/jssjcx
      teacher_manage: /#/jssjzx/grsjzx/jslbgl
      data_compare: /#/jssjzx/grsjzx/sjbd
      model_config: /#/jssjzx/grsjzx/grsjzx_yysz/dataModelManage
      model_permission: /#/jssjzx/grsjzx/grsjzx_yysz/sjqxgl
  
  # 环境2
  "env2":
    base_url: http://your_server_ip:port/dataapp  # ⚠️ 替换为实际服务器地址
    pages:
      my_data: /index#/jssjzx/grsjzx/myarchive
      data_query: /index#/jssjzx/grsjzx/jssjcx
      teacher_manage: /index#/jssjzx/grsjzx/jslbgl
      data_compare: /index#/jssjzx/grsjzx/sjbd
      model_config: /index#/jssjzx/grsjzx/grsjzx_yysz/dataModelManage
      model_permission: /index#/jssjzx/grsjzx/grsjzx_yysz/sjqxgl
  
# 证据收集配置（用于审计）
evidence:
  # 视频录制：always(始终) / on_failure(失败时) / never(不录制)
  video: always
  # 截图：always / on_failure / never
  screenshot: always
  # 保存页面 HTML: true / false
  page_html: always
  # 录制 Playwright Trace: true / false (最详细，包含所有 DOM 快照、网络请求等)
  trace: always
  
# 日志配置
log:
  level: DEBUG  # DEBUG, INFO, WARNING, ERROR
  file: logs/test.log
  console: true
  # 记录网络请求：true / false
  network_log: false
  # 记录浏览器控制台：true / false
  console_log: true

# 认证配置
auth:
  login_url: /login
  default_username: your_username  # ⚠️ 替换为实际用户名
  default_password: your_password  # ⚠️ 替换为实际密码
  default_verify_code: 2222
  default_group: your_identity  # ⚠️ 替换为实际身份名称

# 报告配置
report:
  format: html  # html, allure, junit
  output_dir: reports
  open_report: true

# 日志配置
log:
  level: INFO  # DEBUG, INFO, WARNING, ERROR
  file: logs/test.log
  console: true

# 测试数据
data:
  environment: test  # dev, test, staging, prod
  locale: zh_CN



# OCR 配置
ocr:
  # 偏好引擎: baidu, local, auto
  prefer: baidu
  # 百度 OCR API（高精度，有配额限制）
  baidu:
    api_key: your_baidu_api_key  # ⚠️ 替换为百度 OCR API Key
    secret_key: your_baidu_secret_key  # ⚠️ 替换为百度 OCR Secret Key
  # 本地 Tesseract（免费、离线，但中文识别较差）
  local:
    enabled: true
    tesseract_path: your_tesseract_path  # ⚠️ 替换为 Tesseract 安装路径

# LLM 配置（用于工具进化）
llm:
  # API 基地址（支持任何兼容 OpenAI API 的服务）
  # 本地示例: http://localhost:11434/v1 (Ollama)
  # 远程示例: https://api.openai.com/v1
  api_base: http://your_llm_server_ip:port/v1  # ⚠️ 替换为实际 LLM 服务地址
  # API Key（本地模型可以为空）
  api_key: your_llm_api_key  # ⚠️ 替换为实际 API Key（本地模型可留空）
  # 模型名称
  model: glm-5
  # 请求超时（秒）
  timeout: 60
  # 最大 token 数
  max_tokens: 4096
  # 温度参数
  temperature: 0.7

# 工具进化配置（借鉴 Yunjue-Agent 的 enhance_tools 机制）
evolution:
  # 是否启用工具进化
  enabled: true
  # 失败次数阈值（连续失败多少次触发进化）
  failure_threshold: 3
  # 监控的目录
  monitor_dirs:
    - scripts
    - utils
  # 进化记录存储目录
  report_dir: reports/evolution
  # 是否自动应用改进代码（false 则只记录不应用）
  auto_apply: false
  # 是否启用日志压缩
  enable_compression: false
  # 日志压缩阈值（token 数）
  max_tokens_per_log: 10000