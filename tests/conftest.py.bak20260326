"""
Pytest 配置和 fixtures

设计原则：
1. session 级单浏览器登录，所有测试共享（节省 10+ 秒）
2. 每个测试自主 navigate，不依赖跨测试的页面状态
3. 支持 pytest-xdist 并行（不同 worker 各自独立登录）
"""

import pytest
import pytest_html
import os
import sys
import shutil
from pathlib import Path
from datetime import datetime

project_root = Path(__file__).parent.parent
if str(project_root) not in sys.path:
    sys.path.insert(0, str(project_root))

from config.settings import Settings
from utils._core.browser_manager import BrowserManager
from utils.logger import logger
from utils._core.test_formatter import TestResult, TestResultFormatter


# ============ Session 生命周期 ============

def pytest_sessionstart(session):
    """测试 session 开始前：备份旧证据，清理本轮证据目录"""
    evidence_root = project_root / "reports" / "evidence"
    
    if not evidence_root.exists():
        evidence_root.mkdir(parents=True, exist_ok=True)
        return
    
    # 如果有旧证据，先备份到 backup 目录
    old_items = [d for d in evidence_root.iterdir() if d.is_dir()]
    if old_items:
        backup_root = evidence_root / "_evidence_backup"
        ts = datetime.now().strftime("%Y%m%d_%H%M%S")
        backup_dir = backup_root / ts
        backup_dir.mkdir(parents=True, exist_ok=True)
        
        for item in old_items:
            dest = backup_dir / item.name
            shutil.move(str(item), str(dest))
        
        logger.info(f"旧证据已备份到：_evidence_backup/{ts}/ ({len(old_items)} 个目录)")
    
    # 清理本轮残留（pytest-xdist worker 临时目录等）
    for item in evidence_root.iterdir():
        if item.is_dir():
            shutil.rmtree(item)
        else:
            item.unlink()
    
    logger.info("证据目录已清理，本轮测试开始")


# ============ 命令行选项 ============

def pytest_addoption(parser):
    parser.addoption(
        "--output-format",
        action="store",
        default="json",
        choices=["json", "junit", "table", "csv"],
        help="测试结果输出格式 (默认: json)"
    )
    parser.addoption(
        "--output-file",
        action="store",
        default=None,
        help="测试结果输出文件路径"
    )


